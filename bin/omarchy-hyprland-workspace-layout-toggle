#!/bin/bash

# omarchy:summary=Cycle every workspace through the dwindle, scrolling, and floating layouts, starting from the active one
# omarchy:args=[back]

DIRECTION=${1:-next}
if [[ $DIRECTION != "next" && $DIRECTION != "back" ]]; then
  echo "Usage: omarchy-hyprland-workspace-layout-toggle [back]" >&2
  exit 1
fi

ACTIVE_WORKSPACE=$(hyprctl activeworkspace -j | jq -r '.id')
# A named workspace reports a negative id and has no layout of its own to cycle
# on from, so it is left alone.
[[ $ACTIVE_WORKSPACE =~ ^[0-9]+$ ]] || exit 1

CURRENT_MODE=$(omarchy-hyprland-workspace-layout-current)

if [[ $DIRECTION == "back" ]]; then
  case "$CURRENT_MODE" in
    dwindle) NEW_MODE=floating ;;
    floating) NEW_MODE=scrolling ;;
    *) NEW_MODE=dwindle ;;
  esac
else
  case "$CURRENT_MODE" in
    dwindle) NEW_MODE=scrolling ;;
    scrolling) NEW_MODE=floating ;;
    *) NEW_MODE=dwindle ;;
  esac
fi

# A layout belongs to the whole system rather than to one workspace: the next one
# is chosen from the layout of the workspace in front, and every workspace takes
# it, the ones with windows on them included.
exec omarchy-hyprland-workspace-layout-all "$NEW_MODE"
